---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { content } from '../lib/content.js';

const { projects } = content;

const FOLDER = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>`;
---

<Base title="项目 · Peter267" description="Peter267 做过的一些项目：个人博客、电教委员指南、Classworks Lite、智学网排名计算器等。" pageName="projects">
  <div class="page container">
    <section class="projects-section" id="projects">
      <SectionLabel name="PROJECTS" />
      <h1 class="section-title">{projects.title}</h1>
      <p class="section-lead">{projects.lead}</p>

      <div class="projects-grid">
        {
          projects.items.map((p) => (
            <a
              class="project-card"
              href={p.link || '/projects/'}
              target={p.link ? '_blank' : undefined}
              rel={p.link ? 'noopener noreferrer' : undefined}
            >
              <div class="project-header">
                <span class="project-icon" set:html={FOLDER} />
                <h3 class="project-name">{p.name}</h3>
              </div>
              <p class="project-desc">{p.description}</p>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Base>
