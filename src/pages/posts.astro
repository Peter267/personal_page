---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { content } from '../lib/content.js';

const { posts } = content;
---

<Base title="文章 · Peter267" description="来自 Peter267 博客的最新文章。" pageName="posts">
  <div class="page container">
    <section class="post-section" id="posts">
      <SectionLabel name="POSTS" />
      <h1 class="section-title">{posts.title}</h1>
      <p class="section-lead">{posts.lead}</p>

      <div
        class="post-list"
        id="post-list"
        aria-live="polite"
        aria-busy="true"
      >
        <div class="post-state">{posts.loading}</div>
      </div>

      <div class="post-more">
        <a href={posts.blogUrl} target="_blank" rel="noopener noreferrer">
          浏览博客全部文章 ↗
        </a>
      </div>
    </section>
  </div>
</Base>

<script>
  import { content } from '../lib/content.js';

  /**
   * 文章列表：运行时拉取博客 Atom feed。
   *
   * 注意：这段逻辑必须在 astro:page-load 里跑。ClientRouter 下模块脚本
   * 只执行一次，若只在顶层执行，从别的页面切到 /posts/ 时列表会永远
   * 停在"正在获取…"。
   */
  let request = null;

  function formatDate(iso: string) {
    const t = Date.parse(iso);
    if (Number.isNaN(t)) return '';
    const d = new Date(t + 8 * 60 * 60 * 1000);
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getUTCFullYear()}.${pad(d.getUTCMonth() + 1)}.${pad(d.getUTCDate())}`;
  }

  function excerpt(text: string, max = 96) {
    const clean = String(text || '')
      .replace(/\s+/g, ' ')
      .trim();
    return clean.length > max ? `${clean.slice(0, max)}…` : clean;
  }

  const esc = (s: unknown) =>
    String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

  function fetchPosts() {
    if (request) return request;
    const { feedUrl, blogUrl, limit = 6 } = content.posts;

    request = fetch(feedUrl, { cache: 'no-cache' })
      .then((res) => {
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return res.text();
      })
      .then((xml) => {
        const doc = new DOMParser().parseFromString(xml, 'application/xml');
        if (doc.querySelector('parsererror')) throw new Error('XML 解析失败');

        return Array.from(doc.querySelectorAll('entry'))
          .slice(0, limit)
          .map((entry) => {
            const link =
              entry.querySelector('link[rel="alternate"]') || entry.querySelector('link');
            return {
              title: entry.querySelector('title')?.textContent?.trim() || '无标题',
              url: link?.getAttribute('href') || blogUrl,
              date:
                entry.querySelector('published')?.textContent ||
                entry.querySelector('updated')?.textContent ||
                '',
              summary: entry.querySelector('summary')?.textContent || '',
            };
          });
      })
      .catch((err) => {
        request = null;
        throw err;
      });

    return request;
  }

  let cancelled = false;

  function mount() {
    const list = document.getElementById('post-list');
    if (!list) return;

    cancelled = false;
    list.setAttribute('aria-busy', 'true');

    fetchPosts()
      .then((items) => {
        if (cancelled || !list.isConnected) return;
        list.setAttribute('aria-busy', 'false');

        if (!items.length) {
          list.innerHTML = `<div class="post-state">${esc(content.posts.empty)}</div>`;
          return;
        }

        list.innerHTML = items
          .map(
            (item) => `
            <a class="post-item" href="${esc(item.url)}" target="_blank" rel="noopener noreferrer">
              <span class="post-date">${esc(formatDate(item.date))}</span>
              <span class="post-body">
                <span class="post-title">${esc(item.title)}<span class="post-arrow" aria-hidden="true">↗</span></span>
                ${item.summary ? `<span class="post-summary">${esc(excerpt(item.summary))}</span>` : ''}
              </span>
            </a>`
          )
          .join('');
      })
      .catch((err) => {
        if (cancelled || !list.isConnected) return;
        console.info('[posts] 获取文章失败:', err.message);
        list.setAttribute('aria-busy', 'false');
        list.innerHTML = `<div class="post-state">${esc(content.posts.error)} <a href="${esc(
          content.posts.blogUrl
        )}" target="_blank" rel="noopener noreferrer">前往博客 ↗</a></div>`;
      });
  }

  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => {
    cancelled = true;
  });

  mount();
</script>
